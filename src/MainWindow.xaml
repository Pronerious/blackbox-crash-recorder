<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlackBox — la scatola nera del tuo PC" Width="1280" Height="860" MinWidth="980" MinHeight="680"
        Background="#0E1015" Foreground="#E6E8EE" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="Background" Value="#1D212B"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#2C3240" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2A303D"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- suggerimenti scuri -->
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#1D212B"/>
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="BorderBrush" Value="#2C3240"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
    <!-- caselle di spunta: testo chiaro -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- barre di scorrimento sottili e scure -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" Background="#2E3442" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#465066"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb"><Border Background="#2E3442" CornerRadius="4" Margin="2"/></ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- menu a tendina scuri -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#2A303D"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#22293A"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="#1D212B" BorderBrush="#2C3240" BorderThickness="1" CornerRadius="6">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0" Stroke="#8A91A0" StrokeThickness="1.5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#2A303D"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="10,5,28,5" VerticalAlignment="Center" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#161920" BorderBrush="#2C3240" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                  <ScrollViewer><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#161920"/>
      <Setter Property="BorderBrush" Value="#232733"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="6"/>
    </Style>
    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#8A91A0"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- intestazione -->
    <Grid Grid.Row="0" Margin="6,0,6,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="RecDot" Width="11" Height="11" Fill="#5EE08A" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock Text="BlackBox" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="la scatola nera del tuo PC" FontSize="13" Foreground="#8A91A0" VerticalAlignment="Bottom" Margin="12,0,0,5"/>
        </StackPanel>
        <TextBlock x:Name="SubTitle" Foreground="#8A91A0" FontSize="12.5" Margin="21,2,0,0" Text="Avvio..." TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="BtnReport" Content="Ultimo report"/>
        <Button x:Name="BtnLogs" Content="Apri cartella log"/>
        <Button x:Name="BtnSessions" Content="Partite" ToolTip="Grafici delle partite, confronto di due partite (undervolt), riassunti da copiare"/>
        <Button x:Name="BtnGames" Content="Giochi &amp; OptiScaler"/>
        <Button x:Name="BtnOverlay" Content="Overlay"/>
        <Button x:Name="BtnAuto" Content="Avvio automatico: OFF"/>
        <Button x:Name="BtnGuide" Content="Guida"/>
        <Button x:Name="BtnTray" Content="Nascondi" ToolTip="Nasconde la finestra: BlackBox continua a registrare vicino all'orologio"/>
      </StackPanel>
    </Grid>

    <!-- banner crash -->
    <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" Background="#3A1820" BorderBrush="#FF5C6C" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="6,0,6,6">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="BannerTitle" FontSize="15" FontWeight="SemiBold" Foreground="#FF8A96" Text="Spegnimento anomalo rilevato"/>
          <TextBlock x:Name="BannerText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#F2D5D9"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnOpenCrash" Content="Apri report"/>
          <Button x:Name="BtnHideBanner" Content="Chiudi"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- riquadri sensori -->
    <UniformGrid x:Name="Tiles" Grid.Row="2" Columns="4" Rows="2"/>

    <!-- parte bassa -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*"/>
        <ColumnDefinition Width="1.35*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- attività -->
      <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="0">
        <StackPanel>
          <TextBlock Style="{StaticResource H}" Text="ATTIVITÀ IN QUESTO MOMENTO"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Foreground="#8A91A0" Text="App in primo piano" Margin="0,2"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ActFg" FontWeight="SemiBold" Margin="0,2" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="1" Foreground="#8A91A0" Text="Più CPU" Margin="0,2"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ActCpu" Margin="0,2" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="2" Foreground="#8A91A0" Text="Più GPU" Margin="0,2"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ActGpu" Margin="0,2" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="3" Foreground="#8A91A0" Text="Controllo stato" Margin="0,2"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ActMax" Margin="0,2" TextTrimming="CharacterEllipsis" Cursor="Hand" TextDecorations="Underline" ToolTip="Clicca per il controllo completo"/>
            <TextBlock Grid.Row="4" Foreground="#8A91A0" Text="Sessione di gioco" Margin="0,2"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ActGame" Margin="0,2" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="5" Foreground="#8A91A0" Text="FPS" Margin="0,2" VerticalAlignment="Center"/>
            <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,2">
              <Button x:Name="BtnFps" DockPanel.Dock="Right" Padding="10,3" Visibility="Collapsed"/>
              <TextBlock x:Name="ActFps" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- configurazione A/B -->
      <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="CONFIGURAZIONE ATTUALE (per il test A/B)"/>
          <TextBlock DockPanel.Dock="Top" Foreground="#8A91A0" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                     Text="Scrivi cosa hai impostato (es. &quot;CO -20, EXPO ON, GPU UV 1100mV&quot;) e aggiornalo a ogni modifica: spegnimenti e crash vengono associati alla configurazione attiva."/>
          <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="CfgBox" Background="#0E1015" Foreground="#E6E8EE" BorderBrush="#2C3240" Padding="8,6" FontSize="13" CaretBrush="#E6E8EE"/>
            <Button x:Name="BtnCfg" Grid.Column="1" Content="Salva"/>
          </Grid>
          <StackPanel Margin="0,12,0,0">
            <TextBlock x:Name="CfgInfo" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock x:Name="CfgDays" FontSize="30" FontWeight="SemiBold" Foreground="#5EE08A" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="CfgDaysLbl" Foreground="#8A91A0" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- storico + eventi -->
      <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="1*"/><RowDefinition Height="1*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Grid.Row="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" x:Name="HistTitle" Text="SPEGNIMENTI ANOMALI (KERNEL-POWER 41)"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <TextBlock Style="{StaticResource H}" Margin="0,0,0,4" Text="CRASH DEL DRIVER VIDEO (TDR) E DEI GIOCHI — ultimi 120 giorni"/>
              <TextBlock x:Name="DrvGame" TextWrapping="Wrap" FontSize="12.5"/>
              <TextBlock x:Name="DrvCfg" TextWrapping="Wrap" FontSize="12.5" Foreground="#8A91A0" Margin="0,2,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HistList"/></ScrollViewer>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Grid.Row="1">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="EVENTI (sospensione, errori driver, WHEA, crash app, sblocchi)"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="EvList"/></ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
